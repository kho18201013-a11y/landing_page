{
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/news", "destination": "/news.html" },
    { "source": "/news-detail", "destination": "/news-detail.html" },
    { "source": "/news-write", "destination": "/news-write.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ]
}
